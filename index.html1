            <a href="#location" class="text-lg font-medium text-stone-800 py-3" onclick="toggleMenu()">Clinic Location</a>
            <a href="tel:+916361490577" class="bg-stone-900 text-white py-4 rounded-xl font-bold mt-2 flex justify-center items-center gap-2">
