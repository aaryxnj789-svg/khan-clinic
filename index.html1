    <a href="https://wa.me/916361490577?text=Hello%20Dr.%20Khan,%20I%20want%20to%20book%20an%20appointment." target="_blank" class="whatsapp-float flex items-center gap-3 bg-[#25D366] hover:bg-[#1ebc57] text-white px-5 py-4 rounded-full transition-all hover:scale-105 animate-pulse-slow group">
